{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Demo: run sample queries (offline)",
      "type": "debugpy",
      "request": "launch",
      "module": "src",
      "args": ["--demo", "--offline"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Text chat (offline)",
      "type": "debugpy",
      "request": "launch",
      "module": "src",
      "args": ["--offline"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Text chat (Gemini)",
      "type": "debugpy",
      "request": "launch",
      "module": "src",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Run all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Voice chat (not built yet)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cli_voice.py",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Run ablations (not built yet)",
      "type": "debugpy",
      "request": "launch",
      "module": "eval.run_ablation",
      "args": ["--all", "--repeats", "3"],
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
